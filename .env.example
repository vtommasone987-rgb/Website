# Two env files, both gitignored:
#   .env        — database connection (read by both the Prisma CLI and Next.js)
#   .env.local  — admin credentials
# Copy the relevant sections below and fill in real values.

# --- .env -----------------------------------------------------------------

# Postgres connection string.
#
# For local development, run `npm run db` — it starts Prisma's built-in local
# Postgres (no Docker or cloud account needed) and prints the URL to use here.
#
# For production, use a hosted Postgres connection string (Neon, Vercel
# Postgres, Supabase, etc.).
DATABASE_URL=

# Only needed for local development — `prisma migrate dev` uses a scratch
# database to detect schema drift. `npm run db` provides one on the next port up.
# Omit this in production.
SHADOW_DATABASE_URL=

# --- .env.local -----------------------------------------------------------

# Username for the shared owner login to the /admin back office. Individual
# employees get their own logins, managed at /admin/employees.
ADMIN_USERNAME=

# Password for the shared owner login.
ADMIN_PASSWORD=

# Random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Key used to encrypt two-factor (authenticator app) secrets at rest, so database
# access alone isn't enough to start generating valid login codes. Generate with
# the same command as above:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Keep this separate from ADMIN_SESSION_SECRET on purpose: one key per job means
# rotating the session key doesn't lock everyone out of their authenticator, and
# leaking one doesn't hand over the other.
#
# WARNING: changing this value makes every existing enrollment undecryptable —
# everyone would have to re-scan their QR code. Back it up with your other secrets.
MFA_ENCRYPTION_KEY=

# Cloudflare Turnstile — the CAPTCHA on the two public forms. Leave BOTH blank to
# keep it switched off: the widget won't render and submissions are processed
# exactly as they are today. The honeypot and timing checks run either way.
#
# To switch it on: dash.cloudflare.com -> Turnstile -> Add widget, add your
# domain, then copy the two keys here. The site key is public (it appears in the
# page); the secret key must never leave the server.
#
# Both must be set. One alone is ignored on purpose — a widget whose answer is
# never checked looks protected while protecting nothing.
#
# For local testing, Cloudflare publishes keys that always pass:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated list of origins allowed to make cross-origin requests, used
# for CORS on /api routes and for server actions posted through a proxy/CDN
# domain. Full origins including the scheme, no trailing slash, e.g.:
#   ALLOWED_ORIGINS=https://ohprotech.com,https://www.ohprotech.com
# Leave empty for same-origin only, which is the right setting for local
# development and for a single-domain deployment. There is no "*" wildcard.
ALLOWED_ORIGINS=

# How the real visitor IP is identified, which is what rate limiting counts
# against. Leave BOTH of these empty for local development.
#
# IMPORTANT at deploy time: set whichever matches the host. With neither set,
# every visitor shares one rate-limit bucket, because an unverified
# X-Forwarded-For header can be forged by the caller and is not trusted.
#
# Set ONE of:
#
#   CLIENT_IP_HEADER   — a header the platform sets and overwrites itself:
#                          Cloudflare  -> cf-connecting-ip
#                          Vercel      -> x-vercel-forwarded-for
#   TRUSTED_PROXY_HOPS — for a plain X-Forwarded-For chain, the number of
#                        proxies you operate in front of the app (e.g. 1 for a
#                        single nginx). Counted from the right.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=
