# Two env files, both gitignored:
#   .env        — database connection (read by both the Prisma CLI and Next.js)
#   .env.local  — admin credentials
# Copy the relevant sections below and fill in real values.

# --- .env -----------------------------------------------------------------

# Postgres connection string.
#
# For local development, run `npm run db` — it starts Prisma's built-in local
# Postgres (no Docker or cloud account needed) and prints the URL to use here.
#
# For production, use a hosted Postgres connection string (Neon, Vercel
# Postgres, Supabase, etc.).
DATABASE_URL=

# Only needed for local development — `prisma migrate dev` uses a scratch
# database to detect schema drift. `npm run db` provides one on the next port up.
# Omit this in production.
SHADOW_DATABASE_URL=

# --- .env.local -----------------------------------------------------------

# Username for the shared owner login to the /admin back office. Individual
# employees get their own logins, managed at /admin/employees.
ADMIN_USERNAME=

# Password for the shared owner login.
ADMIN_PASSWORD=

# Random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Comma-separated list of origins allowed to make cross-origin requests, used
# for CORS on /api routes and for server actions posted through a proxy/CDN
# domain. Full origins including the scheme, no trailing slash, e.g.:
#   ALLOWED_ORIGINS=https://ohprotech.com,https://www.ohprotech.com
# Leave empty for same-origin only, which is the right setting for local
# development and for a single-domain deployment. There is no "*" wildcard.
ALLOWED_ORIGINS=
