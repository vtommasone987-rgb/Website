# Copy to .env.local (gitignored) and fill in real values.

# Username for the /admin back office. Change this from the generated dev default.
ADMIN_USERNAME=

# Password for the /admin back office. Change this from the generated dev default.
ADMIN_PASSWORD=

# Random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
